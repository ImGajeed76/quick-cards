    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.12",
    "@types/hyphen": "^1.14.0",
    "@types/sql.js": "^1.4.11",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
